{% comment %}
  Premier Tire - Financing Section
  =================================
  This section allows you to display financing options with customizable text and images.
{% endcomment %}

<div class="section-financing">
  <div class="financing-header">
    <h1>{{ section.settings.header_text }}</h1>
  </div>

  <div class="main">
    <div class="container">
      <div class="content-wrapper">
        <div class="content-main">
          <div class="module">
            <div class="module-content">
              <div class="intro">
                <div class="row">
                  <div class="column col-full">
                    {{ section.settings.intro_text }}
                  </div>
                </div>
              </div>

              {% for block in section.blocks %}
                <div class="finance-box">
                  <div class="row">
                    <div class="column col-2-3 text-content">
                      <h2>{{ block.settings.title }}</h2>
                      <p>{{ block.settings.wippy_description }}</p>
                      <a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
                    </div>
                    <div class="column col-1-3 image-content">
                      {% if block.settings.wippy_logo != blank %}
                        {{
                          block.settings.wippy_logo
                          | image_url: width: 329
                          | image_tag:
                            alt: block.settings.image.alt,
                            loading: 'lazy',
                            style: 'max-width: 100%; max-height: 100%; object-fit: contain;'
                        }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Reset styles */
  .section-financing * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  main:has(.main) {
      box-shadow: none;
  }

  .section-financing {
    line-height: 1.6;
    color: #333;
  }

  /* Header styles */
  .financing-header {
    background-color: {{ section.settings.header_bg_color }};
    color: {{ section.settings.header_text_color }};
    padding: 15px 0;
    text-align: center;
  }

  .financing-header h1 {
    /* font-size: 24px; */
    font-weight: bold;
    margin: 0;
    color: {{ section.settings.header_text_color }};
  }

  /* Container styles */
  .section-financing .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
  }

  /* Content styles */
  .section-financing .content-wrapper {
    width: 100%;
  }

  .section-financing .intro {
    padding: 20px 0;
    border-bottom: 1px solid #eee;
  }

  .section-financing .row {
    clear: both;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
  }

  .section-financing .column {
    display: block;
    margin: 1% 0 1% 1.6%;
  }

  .section-financing .column:first-child {
    margin-left: 0;
  }

  .section-financing .col-full {
    width: 100%;
  }

  .section-financing .col-2-3 {
    width: 66.13%;
  }

  .section-financing .col-1-3 {
    width: 32.26%;
  }

  /* Finance box styles */
  .section-financing .finance-box {
    padding: 20px 75px;
    background-color: {{ section.settings.box_bg_color }};
    margin: 20px 0;
    border-radius: 5px;
  }

  .section-financing .text-content h2 {
    color: {{ section.settings.heading_color }};
    margin-bottom: 15px;
    font-size: 26px;
  }

  .section-financing .text-content p {
    margin-bottom: 20px;
    font-size: 16px;
    color: {{ section.settings.text_color }};
  }

  .section-financing .image-content {
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-financing .image-content img {
    max-width: 100%;
    height: auto;
  }

  /* Button styles */
  .section-financing .button {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 5px;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 14px;
    transition: background-color 0.3s ease;
  }

  .section-financing .button:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
  }

  /* Responsive styles */
  @media only screen and (max-width: 768px) {
    .section-financing .finance-box {
      padding: 20px 30px;
    }
  }

  @media only screen and (max-width: 575px) {
    .section-financing .column {
      margin: 1% 0;
    }

    .section-financing .image-content {
      {% if section.settings.hide_image_on_mobile %}
        display: none;
      {% endif %}
    }

    .section-financing .finance-box {
      padding: 20px;
    }

    .section-financing .col-full,
    .section-financing .col-2-3,
    .section-financing .col-1-3 {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Financing Options",
  "settings": [
    {
      "type": "richtext",
      "id": "header_text",
      "label": "Header Text",
      "default": "<p>FINANCING AVAILABLE</p>"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header Text Color",
      "default": "#ffffff"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Introduction Text",
      "default": "<p>At Premier Tire, we understand that auto repair services and tire needs can be stressful and unplanned. For that reason, we have made it our priority to provide our customers with convenient and affordable options in our unmatched effort to exceed expectations, and ensure your visit to Premier Tire is as painless as possible.</p>"
    },
    {
      "type": "color",
      "id": "box_bg_color",
      "label": "Box Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#333333"
    },
    {
      "type": "checkbox",
      "id": "hide_image_on_mobile",
      "label": "Hide Images on Mobile",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "financing_option",
      "name": "Financing Option",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p>Wippy Loans Financing</p>"
        },
        {
          "type": "richtext",
          "id": "wippy_description",
          "label": "Description",
          "default":"<p>Experience the road to affordable car repairs and upgrades with Wippy: quick, easy, and worry-free financing!</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "image_picker",
          "id": "wippy_logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Financing Options",
      "category": "Custom Content",
      "blocks": [
        {
          "type": "financing_option"
        }
      ]
    }
  ]
}
{% endschema %}
