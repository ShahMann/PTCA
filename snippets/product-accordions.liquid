{%- liquid
  assign enable_full_width = block_settings.enable_full_width
  assign show_description = block_settings.show_description
  assign show_read_more = block_settings.show_read_more
  assign show_accordion_divider = block_settings.show_accordion_divider
  assign heading = block_settings.accordion_heading
  assign heading_style = block_settings.heading_style
  assign bg_color = section.settings.bg_color
  assign tabs_bg_color = block_settings.tabs_bg_color
  assign text = block_settings.accordion_text
  assign page = block_settings.accordion_page

  if show_description
    assign content = product.description | default: text
  else
    assign content = page.content | default: text
  endif

  assign border_opacity = 0
  if show_accordion_divider
    assign border_opacity = 1
  endif

  assign has_bg_color = false
  if tabs_bg_color.alpha != 0.0 and tabs_bg_color != ''
    if bg_color.alpha != 0.0 and bg_color != '' and tabs_bg_color != bg_color
      assign has_bg_color = true
      assign border_opacity = 0
    elsif bg_color.alpha == 0.0 or bg_color == '' and tabs_bg_color != bg_color
      assign has_bg_color = true
      assign border_opacity = 0
    endif
  endif

  assign border_width = 1
  if block_settings.line_thickness == 'bold'
    assign border_width = 2
  endif
-%}

{%- capture style -%}
  --border-opacity: {{ border_opacity }};
  --border-width: {{ border_width }}px;

  {% if has_bg_color -%}
    --bg-item: {{ tabs_bg_color }};
    --bg-ellipsis: {{ tabs_bg_color }};
    --padding-sides: var(--gutter-mobile);
    --padding-title: 0;
  {%- else -%}
    --bg-item: transparent;
    --bg-ellipsis: var(--bg);
    --padding-sides: 0;
    --padding-title: 10px;
    --radius: 0;
  {%- endif %}
{%- endcapture -%}

{%- if show_description or heading != '' and content != '' -%}
  <div class="product__accordion {{ block_settings.text_color }}" data-collapsible style="{{ style }}">
    <button
      class="product__accordion__title {{ heading_style }}"
      aria-controls="ProductAccordion--page-{{ heading | handle }}--{{ section.id }}--{{ block_id }}"
      data-collapsible-trigger
    >
      {{- heading -}}
      {%- render 'icon-toggle-plus' -%}
      {%- render 'icon-toggle-minus' -%}
    </button>
    <div
      class="product__accordion__content"
      id="ProductAccordion--page-{{ heading | handle }}--{{ section.id }}--{{ block_id }}"
      data-collapsible-container
    >
      <div class="product__accordion__inner rte" data-collapsible-content>
        {%- render 'toggle-ellipsis',
          content: content,
          enable_full_width: enable_full_width,
          show_read_more: show_read_more
        -%}
        <div class="specifications-grid">
          {%- comment -%} {% if heading == 'Specification' %}{%- endcomment -%}
          {% if product.metafields.convermax.model != blank %}
            <p><span class="label">Model :</span> {{ product.metafields.convermax.model }}</p>
          {% endif %}

          {% if product.metafields.convermax.manufacturer != blank %}
            <p><span class="label">Manufacturer :</span> {{ product.metafields.convermax.manufacturer }}</p>
          {% endif %}

          {% if product.metafields.convermax.finish != blank %}
            <p><span class="label">Finish :</span> {{ product.metafields.convermax.finish }}</p>
          {% endif %}

          {% if product.metafields.convermax.seat_type != blank %}
            <p><span class="label">Seat Type :</span> {{ product.metafields.convermax.seat_type }}</p>
          {% endif %}
          {% if product.metafields.convermax.backspacing != blank %}
            <p><span class="label">Backspacing :</span> {{ product.metafields.convermax.backspacing }}</p>
          {% endif %}
          {% if product.metafields.convermax.winter_compatible != blank %}
            <p><span class="label">Winter Compatible :</span> {{ product.metafields.convermax.winter_compatible }}</p>
          {% endif %}
          {% if product.metafields.convermax.load_rating != blank %}
            <p><span class="label">Load rating :</span> {{ product.metafields.convermax.load_rating }}</p>
          {% endif %}
          {% if product.metafields.convermax.wheel_bore != blank %}
            <p><span class="label">Wheel bore :</span> {{ product.metafields.convermax.wheel_bore }}</p>
          {% endif %}
          {% if product.metafields.convermax.wheel_offset != blank %}
            <p><span class="label">Wheel offset :</span> {{ product.metafields.convermax.wheel_offset }}</p>
          {% endif %}
          {% if product.metafields.convermax.wheel_bolt_pattern != blank %}
            <p><span class="label">Wheel bolt pattern :</span> {{ product.metafields.convermax.wheel_bolt_pattern }}</p>
          {% endif %}
          {% if product.metafields.convermax.wheel_size != blank %}
            <p><span class="label">Wheel Size :</span> {{ product.metafields.convermax.wheel_size }}</p>
          {% endif %}

          {% if product.metafields.convermax.tire_width != blank %}
            <p><span class="label">Tire Width :</span> {{ product.metafields.convermax.tire_width }}</p>
          {% endif %}

          {% if product.metafields.convermax.tire_speed_rating != blank %}
            <p><span class="label">Tire Speed Rating :</span> {{ product.metafields.convermax.tire_speed_rating }}</p>
          {% endif %}

          {% if product.metafields.convermax.tire_load_index != blank %}
            <p><span class="label">Tire Load Index :</span> {{ product.metafields.convermax.tire_load_index }}</p>
          {% endif %}

          {% if product.metafields.convermax.run_flat != blank %}
            <p><span class="label">Run Flat :</span> {{ product.metafields.convermax.run_flat }}</p>
          {% endif %}

          {% if product.metafields.convermax.season != blank %}
            <p><span class="label">Season :</span> {{ product.metafields.convermax.season }}</p>
          {% endif %}

          {% if product.metafields.convermax.profile != blank %}
            <p><span class="label">Profile :</span> {{ product.metafields.convermax.profile }}</p>
          {% endif %}
          {%- comment -%}
            {% if product.variants.first.weight > 0 %}
              <p>
                Weight: {{ product.variants.first.weight }}
                {{ product.variants.first.weight_unit }}
              </p>
            {% endif %}
          {%- endcomment -%}

          {% if product.metafields.convermax.shipping_weight != blank %}
            <p><span class="label">Shipping Weight :</span> {{ product.metafields.convermax.shipping_weight }}</p>
          {% endif %}

          {% if product.metafields.convermax.wheel_diameter != blank %}
            <p><span class="label">Wheel diameter :</span> {{ product.metafields.convermax.wheel_diameter }}</p>
          {% endif %}

          {% if product.metafields.convermax.utqg != blank %}
            <p><span class="label">UTQG :</span> {{ product.metafields.convermax.utqg }}</p>
          {% endif %}

          {% if product.metafields.convermax.utqg != blank %}
            <p><span class="label">Load Description :</span> {{ product.metafields.convermax.load_description }}</p>
          {% endif %}

          {% if product.metafields.convermax.Size1 != blank %}
            {% assign raw_size = product.metafields.convermax.Size1 %}

            {% if raw_size.first %}
              {%- comment -%} It's an array — show without * before first {%- endcomment -%}
              {% for item in raw_size %}
                {% if forloop.first %}
                  {{ item }}
                {% else %}
                  *{{ item }}
                {% endif %}
                {% unless forloop.last %} {% endunless %}
              {% endfor %}
            {% else %}
              {%- comment -%} It's a string — clean brackets and format {%- endcomment -%}
              {% assign cleaned = raw_size | replace: '[', '' | replace: ']', '' | replace: '"', '' %}
              {% assign parts = cleaned | split: ',' %}
              <p>
                {% for part in parts %}
                  {% if forloop.first %}
                    <span class="label">Size :</span> {{ part }}
                  {% else %}
                    *{{ part }}
                  {% endif %}
                {% endfor %}
              </p>
            {% endif %}
          {% endif %}

          {% if product.metafields.convermax.homologation != blank %}
            <p><span class="label">Homologation :</span> {{ product.metafields.convermax.homologation }}</p>
          {% endif %}
        </div>

        {%- comment -%}{% endif %}{%- endcomment -%}
      </div>
    </div>
  </div>
{%- endif -%}
