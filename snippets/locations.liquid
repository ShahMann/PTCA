{%- liquid
  assign subheading = section.settings.subheading
  assign heading = section.settings.title
  assign bg_color = section.settings.bg_color
  assign gradient = section.settings.gradient | default: 'none'
  assign animations_enabled = settings.animations_enabled
  assign animation_anchor = '#Locations--' | append: section.id
  assign animation_delay = 150

  assign bg_color_set = false
  if gradient != 'none' or bg_color.alpha != 0.0 and bg_color != ''
    assign bg_color_set = true
  endif

  comment
    Images sizes
  endcomment
  # Desktop widths
  assign wrapper_width_lg = '(1440px - 120px)'
  assign img_width_lg = 'calc(' | append: wrapper_width_lg | append: ' / 2)'
  # Tablet widths
  assign wrapper_width_md = '(100vw - 2 * 20px)'
  assign img_width_md = 'calc(' | append: wrapper_width_md | append: ' / 2)'
  # Mobile widths
  assign img_width_sm = 'calc(' | append: wrapper_width_md | append: ')'

  assign sizes = '(min-width: 1024px) ' | append: img_width_lg | append: ', (min-width: 768px) ' | append: img_width_md | append: ', ' | append: img_width_sm
-%}

{{ 'section-locations.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Locations--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    {% if bg_color_set -%}
      {%- if gradient != 'none' -%}
        --bg: {{ gradient }};
      {%- else -%}
        --bg: {{ bg_color }};
      {%- endif -%}
    {%- endif %}
  }
{%- endstyle -%}

<div id="Locations--{{ section.id }}" class="section-padding locations">
  <div class="wrapper locations__wrapper">
    <div class="locations__info">
      {%- if subheading != blank or heading != blank -%}
        <div class="section__header text-left">
          {%- if subheading != blank -%}
            <p class="locations__info-subheading subheading-text"
              {% if animations_enabled %}
                data-aos="fade-up"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-delay="{{ animation_delay }}"
                {%- assign animation_delay = animation_delay | plus: 150 -%}
              {% endif %}>{{ subheading }}</p>
          {% endif %}

          {%- if heading != blank -%}
            <h2 class="locations__info-heading"
              {% if animations_enabled %}
                data-aos="fade-up"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-delay="{{ animation_delay }}"
                {%- assign animation_delay = animation_delay | plus: 150 -%}
              {% endif %}>{{ heading }}</h2>
              {%- if settings.show_spacer_lines -%}
                <hr class="section__heading-line"{% if animations_enabled %}
                  data-aos="fade-up"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-delay="{{ animation_delay }}"
                  {%- assign animation_delay = animation_delay | plus: 150 -%}
                {% endif %}>
              {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="locations__stores"
        data-slider-info
        {% if animations_enabled %}
          data-aos="fade-up"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-delay="{{ animation_delay }}"
          {%- assign animation_delay =  150 -%}
        {% endif %}>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="location__store" {{ block.shopify_attributes }} data-slide-item>
              {%- if block.settings.store_name != blank -%}
                <h3 class="h3">{{ block.settings.store_name }}</h3>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h4 class="location__address h4">{{ block.settings.title }}</h4>
              {%- endif -%}

              {%- if block.settings.working_time != blank -%}
                {{- block.settings.working_time -}}
              {%- endif -%}

            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="location__store" data-slide-item>
              <h3 class="location__address h4">{{ 'homepage.onboarding.locations.address' | t }}</h3>

              {{ 'homepage.onboarding.locations.working_hours_html' | t }}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="locations__gallery"
        data-slider-gallery
        {% if animations_enabled %}
          data-aos="fade"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-delay="{{ animation_delay }}"
        {% endif %}>
        {%- for block in section.blocks -%}
          {%- render 'image-fill',
            img_object: block.settings.image,
            sizes: sizes,
            aspect_ratio: 1,
            classes: 'location__image' -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="locations__gallery"
        data-slider-gallery
        {% if animations_enabled %}
          data-aos="fade"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-delay="{{ animation_delay }}"
        {% endif %}>
        {%- for i in (1..3) -%}
          {%- render 'image-fill',
            img_object: '',
            aspect_ratio: 1,
            classes: 'location__image' -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>