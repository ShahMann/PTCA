<label for="CustomerPassword" class="hidden-label">{{ 'customer.login.password' | t }}</label>
<div class="password-field-container">
  <div class="password-input-wrapper">
    <input
      type="password"
      value=""
      name="customer[password]"
      id="CustomerPassword"
      class="input--full{% if form.errors contains 'password' %} error{% endif %}"
      placeholder="{{ 'customer.login.password' | t }}"
      required
    >
  </div>
  <div class="password-toggle-wrapper">
    <button
      type="button"
      id="LoginPasswordToggleBtn"
      class="password-toggle-btn"
      aria-label="Toggle password visibility"
    >
      <span class="password-toggle-icon password-toggle-icon--show">
        <!-- Eye Icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </span>
      <span class="password-toggle-icon password-toggle-icon--hide" style="display: none;">
        <!-- Eye Off Icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
          <line x1="1" y1="1" x2="23" y2="23"></line>
        </svg>
      </span>
    </button>
  </div>
</div>

<style>
  .password-field-container {
    display: flex;
    position: relative;
  }

  .password-input-wrapper {
    flex-grow: 1;
    position: relative;
  }

  .password-toggle-wrapper {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
  }

  .password-toggle-btn {
    background: none;
    border: none;
    padding: 5px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(14, 12, 12);
  }

  .password-toggle-btn:hover,
  .password-toggle-btn:focus {
    color: #333;
    outline: none;
  }

  .input--full {
    padding-right: 40px;
    width: 100%;
  }

  .password-toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const loginPasswordField = document.getElementById('CustomerPassword');
    const loginToggleBtn = document.getElementById('LoginPasswordToggleBtn');

    if (loginToggleBtn) {
      loginToggleBtn.addEventListener('click', function () {
        const showIcon = this.querySelector('.password-toggle-icon--show');
        const hideIcon = this.querySelector('.password-toggle-icon--hide');

        if (loginPasswordField.type === 'password') {
          loginPasswordField.type = 'text';
          showIcon.style.display = 'none';
          hideIcon.style.display = 'block';
        } else {
          loginPasswordField.type = 'password';
          showIcon.style.display = 'block';
          hideIcon.style.display = 'none';
        }
      });
    }
  });
</script>
