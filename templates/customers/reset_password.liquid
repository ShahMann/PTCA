{%- comment -%} /templates/customers/reset_password.liquid {%- endcomment -%}

{{ 'template-customer.css' | asset_url | stylesheet_tag }}

<section class="page-customer">
  <div class="wrapper">
    <div class="reset-password">
      <div class="reset-password__form">
        <div class="form-vertical">
          {% form 'reset_customer_password', id: 'ResetCustomerPassword' %}
            <h3 class="account__heading account__heading--small">{{ 'customer.reset_password.title' | t }}</h3>

            <p class="text-left">{{ 'customer.reset_password.subtext' | t: email: email }}</p>

            {{ form.errors | default_errors }}

            <div class="password-field-container">
              <div class="password-input-wrapper">
                <label for="ResetPassword" class="hidden-label">{{ 'customer.reset_password.password' | t }}</label>
                <input
                  type="password"
                  value=""
                  name="customer[password]"
                  id="ResetPassword"
                  class="input--full{% if form.errors contains 'password' %} error{% endif %}"
                  placeholder="{{ 'customer.reset_password.password' | t }}"
                >
              </div>
              <div class="password-toggle-wrapper">
                <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                  <span class="password-toggle-icon password-toggle-icon--show">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                  </span>
                  <span class="password-toggle-icon password-toggle-icon--hide" style="display: none;">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 0 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                  </span>
                </button>
              </div>
            </div>

            <div class="password-field-container">
              <div class="password-input-wrapper">
                <label for="PasswordConfirmation" class="hidden-label">
                  {{- 'customer.reset_password.password_confirm' | t -}}
                </label>
                <input
                  type="password"
                  value=""
                  name="customer[password_confirmation]"
                  id="PasswordConfirmation"
                  class="input--full{% if form.errors contains 'password_confirmation' %} error{% endif %}"
                  placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
                >
              </div>
              <div class="password-toggle-wrapper">
                <button type="button" class="password-toggle-btn" aria-label="Toggle confirm password visibility">
                  <span class="password-toggle-icon password-toggle-icon--show">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                  </span>
                  <span class="password-toggle-icon password-toggle-icon--hide" style="display: none;">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 0 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                    </svg>
                  </span>
                </button>
              </div>
            </div>

            <div class="text-center">
              <button type="submit" class="btn btn--primary btn--solid btn--advanced btn--advanced-width-height">
                <hover-button></hover-button>
                {{- 'customer.reset_password.submit' | t -}}
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
  	const toggleButtons = document.querySelectorAll('.password-toggle-btn');

  	toggleButtons.forEach(button => {
  		button.addEventListener('click', function () {
  			const container = this.closest('.password-field-container');
  			const input = container.querySelector('input');
  			const showIcon = this.querySelector('.password-toggle-icon--show');
  			const hideIcon = this.querySelector('.password-toggle-icon--hide');

  			if (input.type === 'password') {
  				input.type = 'text';
  				showIcon.style.display = 'none';
  				hideIcon.style.display = 'inline-block';
  			} else {
  				input.type = 'password';
  				showIcon.style.display = 'inline-block';
  				hideIcon.style.display = 'none';
  			}
  			input.focus();
  		});
  	});
  });
</script>

<style>
  .password-field-container {
  	display: flex;
  	align-items: center;
  	position: relative;
  	margin-bottom: 16px;
  }
  .password-input-wrapper {
  	flex: 1;
  	position: relative;
  }
  .password-toggle-wrapper {
  	position: absolute;
  	right: 10px;
  	top: 50%;
  	transform: translateY(-50%);
  	z-index: 2;
  }
  .password-toggle-btn {
  	background: none;
  	border: none;
  	cursor: pointer;
  	padding: 0;
  }
  .password-toggle-icon {
  	color: black;
  	display: inline-flex;
  	align-items: center;
  	justify-content: center;
  }
  .password-toggle-icon svg {
  	width: 24px;
  }
  .page-customer .text-center .btn--solid{
    width: 100%;
  }
</style>
