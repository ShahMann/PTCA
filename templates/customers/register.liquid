{%- comment -%} /templates/customers/register.liquid {%- endcomment -%}

{{ 'template-customer.css' | asset_url | stylesheet_tag }}

<section class="page-customer">
  <div class="wrapper">
    <div class="form-vertical-wrapper">
      <div class="section__header">
        <h2 class="section__heading account__heading account__heading--small">{{ 'customer.register.title' | t }}</h2>
        {%- if settings.show_spacer_lines -%}
          <hr class="section__heading-line">
        {%- endif -%}
      </div>
      <div class="form-vertical">
        {% form 'create_customer', id: 'CreateCustomer' %}
          <div id="form-errors-container">
            {{ form.errors | default_errors }}
          </div>
          <label for="FirstName" class="hidden-label">{{ 'customer.register.first_name' | t }}</label>
          <input
            type="text"
            name="customer[first_name]"
            id="FirstName"
            class="input--full"
            placeholder="{{ 'customer.register.first_name' | t }}"
            {% if form.first_name %}
              value="{{ form.first_name }}"
            {% endif %}
            autocapitalize="words"
            autofocus
          >
          <label for="LastName" class="hidden-label">{{ 'customer.register.last_name' | t }}</label>
          <input
            type="text"
            name="customer[last_name]"
            id="LastName"
            class="input--full"
            placeholder="{{ 'customer.register.last_name' | t }}"
            {% if form.last_name %}
              value="{{ form.last_name }}"
            {% endif %}
            autocapitalize="words"
          >
          <label for="Email" class="hidden-label">{{ 'customer.register.email' | t }}</label>
          <input
            type="email"
            name="customer[email]"
            id="Email"
            class="input--full{% if form.errors contains 'email' %} error{% endif %}"
            placeholder="{{ 'customer.register.email' | t }}"
            {% if form.email %}
              value="{{ form.email }}"
            {% endif %}
            autocorrect="off"
            autocapitalize="off"
            required
          >
          <div class="password-field-container">
            <div class="password-input-wrapper">
              <label for="CreatePassword" class="hidden-label">{{ 'customer.register.password' | t }}</label>
              <input
                type="password"
                name="customer[password]"
                id="CreatePassword"
                class="input--full{% if form.errors contains 'password' %} error{% endif %}"
                placeholder="{{ 'customer.register.password' | t }}"
                required
              >
            </div>
            <div class="password-toggle-wrapper">
              <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                <span class="password-toggle-icon password-toggle-icon--show">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                  </svg>
                </span>
                <span class="password-toggle-icon password-toggle-icon--hide" style="display: none;">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 0 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <div class="password-field-container">
            <div class="password-input-wrapper">
              <label for="ConfirmPassword" class="hidden-label">Confirm Password</label>
              <input
                type="password"
                id="ConfirmPassword"
                name="customer[password_confirmation]"
                class="input--full{% if form.errors contains 'password_confirmation' %} error{% endif %}"
                placeholder="Confirm Password"
                required
              >
            </div>
            <div class="password-toggle-wrapper">
              <button type="button" class="password-toggle-btn" aria-label="Toggle confirm password visibility">
                <span class="password-toggle-icon password-toggle-icon--show">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                  </svg>
                </span>
                <span class="password-toggle-icon password-toggle-icon--hide" style="display: none;">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 0 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <!-- Newsletter Signup Checkbox -->
          <div class="newsletter-signup-container">
            <label for="NewsletterSignup" class="checkbox-label">
              <input type="checkbox" name="customer[accepts_marketing]" id="NewsletterSignup">
              <span class="light-gray">Sign up for newsletter</span>
            </label>
          </div>

          <button type="submit" class="btn btn--primary btn--solid btn--advanced btn--advanced-width-height">
            <hover-button></hover-button>
            {{- 'customer.register.submit' | t -}}
          </button>
          <a class="return light-gray return-store" href="{{ shop.url }}">{{ 'customer.register.cancel' | t }}</a>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const createPasswordField = document.getElementById('CreatePassword');
    const confirmPasswordField = document.getElementById('ConfirmPassword');
    const createCustomerForm = document.getElementById('CreateCustomer');
    const errorsContainer = document.getElementById('form-errors-container');
    const toggleButtons = document.querySelectorAll('.password-toggle-btn');

    // Handle password toggle buttons
    toggleButtons.forEach(button => {
      button.addEventListener('click', function () {
        const container = this.closest('.password-field-container');
        const input = container.querySelector('input');
        const showIcon = this.querySelector('.password-toggle-icon--show');
        const hideIcon = this.querySelector('.password-toggle-icon--hide');

        if (input.type === 'password') {
          input.type = 'text';
          showIcon.style.display = 'none';
          hideIcon.style.display = 'inline-block';
        } else {
          input.type = 'password';
          showIcon.style.display = 'inline-block';
          hideIcon.style.display = 'none';
        }
        input.focus();
      });
    });

    // Check passwords match on input for both fields
    if (createPasswordField && confirmPasswordField) {
      // Initial check when page loads
      checkPasswordsMatch();
      
      // Function to check if passwords match and update styling
      function checkPasswordsMatch() {
        // Only validate when both fields have content
        if (confirmPasswordField.value && createPasswordField.value) {
          if (confirmPasswordField.value !== createPasswordField.value) {
            confirmPasswordField.classList.add('error');
            createPasswordField.classList.add('error');
          } else {
            confirmPasswordField.classList.remove('error');
            createPasswordField.classList.remove('error');
          }
        } else if (confirmPasswordField.value) {
          // If only confirm field has content, check if it matches
          if (confirmPasswordField.value !== createPasswordField.value) {
            confirmPasswordField.classList.add('error');
          } else {
            confirmPasswordField.classList.remove('error');
          }
        }
      }
      
      // Check when either password field changes
      createPasswordField.addEventListener('input', checkPasswordsMatch);
      confirmPasswordField.addEventListener('input', checkPasswordsMatch);
    }

    if (createCustomerForm) {
      createCustomerForm.addEventListener('submit', function(event) {
        // Validate password match
        if (createPasswordField.value !== confirmPasswordField.value) {
          // Prevent the form from submitting
          event.preventDefault();
          event.stopPropagation();
          
          // Create error message in Shopify's format
          const errorDiv = document.createElement('div');
          errorDiv.className = 'form-message form-message--error errors';
          
          // Create the error list in the format Shopify uses
          errorDiv.innerHTML = `
            <ul>
              <li>The password confirmation must match the provided password.</li>
            </ul>
          `;
          
          // Clear any existing errors and add our new error
          errorsContainer.innerHTML = '';
          errorsContainer.appendChild(errorDiv);
          
          // Add error styling to password fields
          createPasswordField.classList.add('error');
          confirmPasswordField.classList.add('error');
          
          // Scroll to error message
          window.scrollTo({
            top: errorsContainer.offsetTop - 100,
            behavior: 'smooth'
          });

          return false;
        }
        // If we get here, passwords match and form can submit
        return true;
      }, true); // Using capture phase for earliest interception
    }
  });
</script>
<style>
  .newsletter-signup-container {
    margin-bottom: 20px;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    margin-right: 8px;
    margin-bottom: 0;
  }

  .password-field-container {
    display: flex;
    align-items: center;
    position: relative;
  }

  .password-input-wrapper {
    flex: 1;
    position: relative;
  }

  .password-toggle-wrapper {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .password-toggle-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .password-toggle-icon {
    color: black;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .password-toggle-icon svg {
    width: 24px;
  }
  .page-customer .form-vertical-wrapper .form-vertical .return-store{
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
